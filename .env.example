############################################################
#   EduSHAMIIT – .env.example
#   Copy to .env and fill in real values before running.
#   NEVER commit .env to version control.
############################################################

# ============================================================
# SECRETS  ← CHANGE ALL OF THESE
# ============================================================
POSTGRES_PASSWORD=change-me-long-secure-password
JWT_SECRET=change-me-at-least-32-characters-long-secret
ANON_KEY=<generate-from-supabase-jwt-tool>
SERVICE_ROLE_KEY=<generate-from-supabase-jwt-tool>
DASHBOARD_USERNAME=admin
DASHBOARD_PASSWORD=change-me-dashboard-password
SECRET_KEY_BASE=change-me-64-char-minimum-random-string-here-for-realtime-supavisor
VAULT_ENC_KEY=change-me-exactly-32-characters!!
PG_META_CRYPTO_KEY=change-me-at-least-32-chars-long!
LOGFLARE_PUBLIC_ACCESS_TOKEN=change-me-logflare-public-token
LOGFLARE_PRIVATE_ACCESS_TOKEN=change-me-logflare-private-token
S3_PROTOCOL_ACCESS_KEY_ID=change-me-s3-access-key-id
S3_PROTOCOL_ACCESS_KEY_SECRET=change-me-s3-secret-key
REDIS_PASSWORD=change-me-redis-password
RABBITMQ_USER=eduSHAMIIT
RABBITMQ_PASSWORD=change-me-rabbitmq-password
APP_SECRET_KEY=change-me-app-secret-key

# COTURN – STUN/TURN server shared secret for WebRTC (time-limited credentials)
COTURN_SECRET=change-me-coturn-secret-min-32-chars
COTURN_HOST=127.0.0.1

# ============================================================
# DATABASE
# ============================================================
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_DB=postgres

# ============================================================
# SUPABASE URLS
# ============================================================
SUPABASE_PUBLIC_URL=http://localhost:8000
API_EXTERNAL_URL=http://localhost:8000

# ============================================================
# KONG GATEWAY PORTS
# ============================================================
KONG_HTTP_PORT=8000
KONG_HTTPS_PORT=8443

# ============================================================
# STUDIO
# ============================================================
STUDIO_DEFAULT_ORGANIZATION=Your Organization
STUDIO_DEFAULT_PROJECT=Your Project
SNIPPETS_MANAGEMENT_FOLDER=/app/snippets

# ============================================================
# AUTH (GoTrue)
# ============================================================
SITE_URL=http://localhost:3000
ADDITIONAL_REDIRECT_URLS=
JWT_EXPIRY=3600
DISABLE_SIGNUP=false
ENABLE_EMAIL_SIGNUP=true
ENABLE_EMAIL_AUTOCONFIRM=true
ENABLE_ANONYMOUS_USERS=false
ENABLE_PHONE_SIGNUP=true
ENABLE_PHONE_AUTOCONFIRM=true
MAILER_URLPATHS_CONFIRMATION=/auth/v1/verify
MAILER_URLPATHS_INVITE=/auth/v1/verify
MAILER_URLPATHS_RECOVERY=/auth/v1/verify
MAILER_URLPATHS_EMAIL_CHANGE=/auth/v1/verify

# SMTP
SMTP_ADMIN_EMAIL=admin@example.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_SENDER_NAME=EduSHAMIIT

# ============================================================
# STORAGE
# ============================================================
GLOBAL_S3_BUCKET=stub
REGION=stub
STORAGE_TENANT_ID=stub
IMGPROXY_AUTO_WEBP=true

# ============================================================
# PostgREST
# ============================================================
PGRST_DB_SCHEMAS=public,storage,graphql_public
PGRST_DB_MAX_ROWS=1000
PGRST_DB_EXTRA_SEARCH_PATH=public

# ============================================================
# ANALYTICS
# ============================================================
DOCKER_SOCKET_LOCATION=/var/run/docker.sock

# ============================================================
# SUPAVISOR
# ============================================================
POOLER_PROXY_PORT_TRANSACTION=6543
POOLER_DEFAULT_POOL_SIZE=20
POOLER_MAX_CLIENT_CONN=100
POOLER_TENANT_ID=your-tenant-id
POOLER_DB_POOL_SIZE=5

# ============================================================
# REDIS
# ============================================================
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://:change-me-redis-password@redis:6379

# ============================================================
# RABBITMQ
# ============================================================
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_MGMT_PORT=15672
RABBITMQ_URL=amqp://eduSHAMIIT:change-me-rabbitmq-password@rabbitmq:5672

# ============================================================
# MQTT / IoT
# ============================================================
MQTT_BROKER_HOST=mosquitto
MQTT_BROKER_PORT=1883

# ============================================================
# FASTAPI BACKEND
# ============================================================
DATABASE_URL=postgresql://postgres:change-me@db:5432/postgres
SUPABASE_URL=http://kong:8000
SUPABASE_ANON_KEY=<same-as-ANON_KEY-above>
SUPABASE_SERVICE_ROLE_KEY=<same-as-SERVICE_ROLE_KEY-above>
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=1440
ENVIRONMENT=development
DEBUG=true
APP_ENV=development

# ============================================================
# AI MODELS
# ============================================================
OPENAI_API_KEY=sk-your-openai-key
ANTHROPIC_API_KEY=sk-ant-your-anthropic-key
GOOGLE_API_KEY=AIza-your-google-key

# ============================================================
# PAYMENTS
# ============================================================
UPI_MERCHANT_ID=your-school@upi
UPI_MERCHANT_NAME=Your School Name
RAZORPAY_KEY_ID=rzp_test_your_key
RAZORPAY_SECRET=your_razorpay_secret

# ============================================================
# WHATSAPP
# ============================================================
WHATSAPP_API_KEY=your-whatsapp-key
WHATSAPP_NUMBER=91XXXXXXXXXX

# ============================================================
# TTS
# ============================================================
GOOGLE_TTS_API_KEY=your-google-tts-key
ELEVENLABS_API_KEY=your-elevenlabs-key

# ============================================================
# EMAIL / OTP
# ============================================================
EMAIL_FROM=your-email@example.com
EMAIL_RETRY_ATTEMPTS=3
EMAIL_RETRY_DELAY=1
OTP_LENGTH=6
OTP_EXPIRATION_MINUTES=15
OTP_RATE_LIMIT_PER_HOUR=3
